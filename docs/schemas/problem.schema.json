{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StudyTree Problem",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "type", "title", "stem", "answer", "meta"],
  "properties": {
    "v": { "type": "integer", "minimum": 1, "description": "Schema version" },

    "type": {
      "type": "string",
      "enum": ["mcq", "written"],
      "description": "Problem type"
    },

    "title": { "type": "string", "minLength": 1, "maxLength": 160 },

    "stem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Problem statement (may include LaTeX as plain text)"
    },

    "context": {
      "type": "string",
      "maxLength": 2000,
      "description": "Optional context / preface shown before stem"
    },

    "parts": {
      "type": "array",
      "description": "Optional sub-questions. If present, UI can render multi-part problems.",
      "items": { "$ref": "#/$defs/part" },
      "default": []
    },

    "answer": {
      "description": "Answer payload. Shape depends on type.",
      "oneOf": [
        { "$ref": "#/$defs/answer_mcq" },
        { "$ref": "#/$defs/answer_written" }
      ]
    },

    "explanation": {
      "type": "string",
      "maxLength": 8000,
      "description": "Solution / explanation shown after answering",
      "default": ""
    },

    "assets": {
      "type": "array",
      "description": "Attachments such as images or code snippets",
      "items": { "$ref": "#/$defs/asset" },
      "default": []
    },

    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter_node_id", "difficulty", "tags"],
      "properties": {
        "chapter_node_id": { "type": "string", "minLength": 1, "maxLength": 64 },

        "prereq_node_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "default": []
        },

        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1(easy) - 5(hard)"
        },

        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 32 },
          "default": []
        },

        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "enum": ["book", "web", "lecture", "other"], "default": "book" },
            "ref": { "type": "string", "maxLength": 200, "description": "e.g., book page or URL or note id" }
          },
          "default": { "kind": "book" }
        },

        "created_by": { "type": "string", "maxLength": 64, "default": "manual" },
        "language": { "type": "string", "maxLength": 16, "default": "ja" }
      }
    },

    "x": {
      "type": "object",
      "description": "Extension bucket for future fields. Do not rely on it for core logic.",
      "additionalProperties": true,
      "default": {}
    }
  },

  "$defs": {
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stem"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 32 },
        "stem": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "answer_hint": { "type": "string", "maxLength": 500 }
      }
    },

    "answer_mcq": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "choices", "correct"],
      "properties": {
        "kind": { "const": "mcq" },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/choice" }
        },
        "correct": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 32 },
          "description": "Array of choice ids (supports multi-correct)"
        },
        "shuffle_choices": { "type": "boolean", "default": false }
      }
    },

    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 32 },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },

    "answer_written": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expected"],
      "properties": {
        "kind": { "const": "written" },

        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_answer"],
          "properties": {
            "model_answer": { "type": "string", "minLength": 1, "maxLength": 4000 },
            "key_points": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 200 },
              "default": []
            }
          }
        },

        "answer_format": {
          "type": "string",
          "enum": ["free", "numeric", "formula", "code", "bullet"],
          "default": "free"
        },

        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_chars": { "type": "integer", "minimum": 1 },
            "max_minutes": { "type": "integer", "minimum": 1 }
          },
          "default": {}
        }
      }
    },

    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "type": "string", "enum": ["image", "code", "latex", "file", "link"] },
        "ref": { "type": "string", "minLength": 1, "maxLength": 500 },
        "caption": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
